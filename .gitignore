build/
# The embedded Vulkan driver is fetched, not committed (10 MB binary).
# PROVENANCE.txt next to it *is* committed — it is the record of what it was.
android/app/src/main/jniLibs/arm64-v8a/*.so
# The driver-plugin module's copy, when that module is enabled.
android/driver-plugin/src/main/jniLibs/arm64-v8a/*.so
# A restore image is 16 GB of Apple's bytes, not ours.
android/ipsw/
# Local run artefacts: guest RAM dumps, firmware dumps, the sparse disk image.
work/
# Gradle writes its own caches; they are not source.
android/.gradle/

# Per-run work directories with a suffix (workM2, workN1, workP1, ...): the
# same guest RAM dumps, aux.img and sparse disk image as work/.
work*/
